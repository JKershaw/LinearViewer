{
  "name": "harbour",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node scripts/run-unit-tests.mjs tests/unit/*.test.js scripts/eval/eval-dense.test.mjs scripts/code-shape/*.test.mjs && playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "node scripts/run-unit-tests.mjs tests/unit/*.test.js scripts/eval/eval-dense.test.mjs scripts/code-shape/*.test.mjs",
    "env:check": "bash scripts/env-check.sh",
    "setup": "bash scripts/setup.sh",
    "test:hermetic": "node scripts/assert-unit-suite-hermetic.mjs",
    "test:hermetic:proxy": "node scripts/assert-unit-suite-hermetic.mjs --proxy",
    "test:clock-shift": "CLOCK_SHIFT_DAYS=400 NODE_OPTIONS=--import=$PWD/tests/fixtures/clock-shift.js npm run test:unit",
    "secret-scan": "node scripts/secret-scan.mjs",
    "scan:public-pages": "node scripts/scan-public-pages.mjs",
    "figures:theme": "node scripts/figure-theme.mjs"
  },
  "dependencies": {
    "@jkershaw/mangodb": "^0.1.2",
    "chart.js": "4.5.1",
    "dompurify": "3.4.17",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "graphql": "^16.12.0",
    "graphql-request": "^6.1.0",
    "https-proxy-agent": "^7.0.6",
    "marked": "^17.0.1",
    "mongodb": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "acorn": "8.12.1",
    "acorn-walk": "8.3.4",
    "playwright": "1.57.0"
  }
}
