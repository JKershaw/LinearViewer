node_modules/
.env
data/
test-results/

# Bulk auto-fetched proxy task fixtures (fetch-proxy-tasks.mjs writes per-epic subdirs of
# live Linear text) stay out of this public repo. Exception: curated, deliberately-committed
# red-baseline fixtures (e.g. the HAR-697 divergence case — Harbour is a public pet project)
# are checked in so the eval's realistic red bar runs on any clone / in CI.
scripts/eval/fixtures/*
!scripts/eval/fixtures/HAR-697-red.json
# Curated recommend-baseline context bundles (real Harbour + LinearViewer task text,
# both public) are committed so eval-recommend-baseline.mjs runs token-free (LIN-587).
!scripts/eval/fixtures/recommend/
scripts/eval/fixtures/recommend/*
!scripts/eval/fixtures/recommend/*.json
