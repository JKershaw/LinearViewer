# Linear OAuth credentials
# Get these from Linear Settings > API > OAuth Applications
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URI=http://localhost:3000/auth/callback

# GitHub OAuth credentials (optional - enables "Continue with GitHub" login and
# adding a GitHub repository as a workspace source, LIN-541)
# Under the GitHub App model (LIN-703) these are the App's OWN user-to-server
# OAuth credentials (Settings > General > "Client ID"/"Client secrets" on the App
# page — NOT a separate OAuth App). They drive the code->user-token leg of the
# already-installed re-bind flow (LIN-728): when the App is already installed,
# GitHub round-trips an OAuth `code` instead of a fresh installation_id, and
# Harbour exchanges it to enumerate the user's installations and re-pick a repo.
# REQUIRES the App toggle "Request user authorization (OAuth) during
# installation" (Settings > General) — without it the re-bind round-trip never
# returns a `code` and an already-installed repo cannot be re-added.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback

# GitHub App credentials (LIN-703 migration — per-repo, Issues-only permissions
# via a GitHub App installation instead of an OAuth App). Create an App at
# https://github.com/settings/apps; GITHUB_APP_PRIVATE_KEY is the PEM contents
# (multi-line, or single-line with \n escapes), GITHUB_APP_SLUG is the App's URL
# slug used to build the installation URL.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_SLUG=

# Personal Access Token (optional - bypasses OAuth for local development)
# Get your token from: https://linear.app/settings/api
# When set, the app auto-authenticates without OAuth flow.
# LINEAR_ACCESS_TOKEN=lin_api_xxxxx

# Session secret (generate a random string)
SESSION_SECRET=change-this-to-a-random-string

# Server port
PORT=3000

# MongoDB connection string (optional)
# When unset, falls back to MangoDB file-based session storage for development.
# MONGODB_URI=mongodb://localhost:27017

# OpenRouter API key (optional - enables AI recommendation feature)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter OAuth callback (optional)
# Defaults to /auth/openrouter/callback when unset.
# OPENROUTER_REDIRECT_URI=http://localhost:3000/auth/openrouter/callback

# OpenRouter free-tier key (optional)
# When set, users without their own OpenRouter connection get rate-limited free prompts.
# OPENROUTER_FREE_TIER_KEY=

# Yap chat server (optional — the experimental Collective feature)
# Base URL of the Yap server that hosts the cross-project discussion.
# Defaults to https://yap.jkershaw.com when unset, so the Collective live view
# works out of the box; override to point at a different Yap server.
# YAP_BASE_URL=https://yap.jkershaw.com
# Optional Yap server password (sent as Authorization: Bearer <password>).
# YAP_PASSWORD=
